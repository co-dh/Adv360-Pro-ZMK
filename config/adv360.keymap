#include <dt-bindings/zmk/stp.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE                      &kp N1          &kp N2          &kp N3       &kp N4            &kp N5  &tog 1                                                                      &mo 3              &kp N6  &kp N7            &kp N8        &kp N9          &kp N0           &kp MINUS
&kp TAB                        &kp Q           &kp W           &kp F        &kp P             &kp V   &kp EQUAL                                                                   &kp LEFT_BRACKET   &kp J   &kp L             &kp U         &kp Y           &kp SEMICOLON    &kp BSLH
&kp ESC                        &hm LEFT_GUI A  &hm LEFT_ALT R  &hm LCTRL S  &hm LEFT_SHIFT T  &kp G   &kp CAPS     &kp LEFT_GUI  &kp LCTRL         &kp RCTRL     &kp RIGHT_GUI    &kp RIGHT_BRACKET  &kp M   &hm LEFT_SHIFT N  &hm RCTRL E   &hm LEFT_ALT I  &hm RIGHT_GUI O  &kp SQT
&kp LSHFT                      &kp Z           &kp X           &kp C        &kp D             &kp B                              &kp DELETE        &kp INS                                           &kp K   &kp H             &kp COMMA     &kp DOT         &kp FSLH         &kp RSHFT
&hm LEFT_CONTROL LEFT_BRACKET  &kp HOME        &kp END         &kp LEFT     &kp RIGHT                 &lt 1 SPACE  &lt 2 ENTER   &kp LEFT_ALT      &kp LEFT_ALT  &lt 5 BACKSPACE  &lt 4 SPACE                &kp DOWN          &kp UP_ARROW  &kp PAGE_UP     &kp PAGE_DOWN    &hm RCTRL RIGHT_BRACKET
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans            &kp LA(LC(F1))  &kp LA(LC(F2))  &trans     &trans          &trans  &to 1                                       &mo 5   &trans             &trans        &trans        &trans        &trans                &trans
&trans            &trans          &trans          &trans     &trans          &trans  &trans                                      &trans  &kp LEFT_BRACKET   &kp N7        &kp N8        &kp N9        &kp NON_US_BACKSLASH  &trans
&trans            &kp LEFT_META   &kp LEFT_ALT    &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp RIGHT_BRACKET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SQT               &trans
&trans            &trans          &trans          &trans     &trans          &trans                  &trans      &trans                  &trans             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS             &trans
&kp LEFT_CONTROL  &trans          &trans          &trans     &trans                  &trans  &trans  &trans      &trans  &trans  &kp N0                     &trans        &trans        &trans        &trans                &kp GRAVE
            >;
        };

        sym {
            display-name = "Kp";
            bindings = <
&trans            &kp LA(LC(F1))  &kp LA(LC(F2))  &trans     &trans          &trans  &to 1                                       &mo 5   &trans             &trans        &trans        &trans        &trans                &trans
&trans            &trans          &trans          &trans     &trans          &trans  &trans                                      &trans  &kp LEFT_BRACKET   &kp N7        &kp N8        &kp N9        &kp NON_US_BACKSLASH  &trans
&trans            &kp LEFT_META   &kp LEFT_ALT    &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp RIGHT_BRACKET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SQT               &trans
&trans            &trans          &trans          &trans     &trans          &trans                  &trans      &trans                  &trans             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS             &trans
&kp LEFT_CONTROL  &trans          &trans          &trans     &trans                  &trans  &trans  &trans      &trans  &trans  &kp N0                     &trans        &trans        &trans        &trans                &kp GRAVE
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F12  &kp F1    &kp F2        &kp F3          &kp F4          &kp F5  &tog 1                                      &mo 5   &kp F6     &kp F7     &kp F8    &kp F9    &kp F10  &kp F11
&trans   &trans    &caps_word    &kp LS(INSERT)  &kp LC(INSERT)  &trans  &trans                                      &trans  &trans     &trans     &trans    &trans    &trans   &trans
&trans   &kp LEFT  &kp UP_ARROW  &kp DOWN        &kp RIGHT       &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp RGUI  &trans   &trans
&trans   &kp HOME  &kp PAGE_UP   &kp PAGE_DOWN   &kp END         &trans                  &trans      &trans                  &trans     &trans     &kp RALT  &trans    &trans   &trans
&trans   &trans    &trans        &trans          &trans                  &trans  &trans  &trans      &trans  &trans  &trans             &trans     &trans    &trans    &trans   &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
