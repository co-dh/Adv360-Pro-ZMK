#include <dt-bindings/zmk/stp.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv {
    time-to-max-speed-ms = <300>;
    trigger-period-ms = <25>;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_modsL {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODSL";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 21 40 39 54 8 22 9 23 41 55 71 10 24 42 56 72 25 11 43 57 73 12 26 44 58 74 75 59 45 27 13 38 37 53 68 69 70>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 0 14 28 46 60 1 2 3 4 5 6 15 16 17 18 19 20 29 30 31 32 33 34 35 36 47 48 49 50 51 52 61 62 63 64 65 66 67>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE           &kp N1          &kp N2          &kp N3       &kp N4            &kp N5  &tog 1                                                                 &mo 6              &kp N6  &kp N7             &kp N8        &kp N9           &kp N0            &kp MINUS
&kp TAB             &kp Q           &kp W           &kp F        &kp P             &kp V   &kp EQUAL                                                              &kp LEFT_BRACKET   &kp J   &kp L              &kp U         &kp Y            &kp SEMICOLON     &kp BSLH
&kp ESC             &hm LEFT_GUI A  &hm LEFT_ALT R  &hm LCTRL S  &hm LEFT_SHIFT T  &kp G   &kp CAPS     &kp LEFT_GUI  &kp LCTRL       &kp RCTRL  &kp RIGHT_GUI    &kp RIGHT_BRACKET  &kp M   &hmr LEFT_SHIFT N  &hmr RCTRL E  &hmr LEFT_ALT I  &hmr RIGHT_GUI O  &kp SQT
&kp LSHFT           &kp Z           &kp X           &kp C        &kp D             &kp B                              &kp DELETE      &kp INS                                        &kp K   &kp H              &kp COMMA     &kp DOT          &kp FSLH          &kp RSHFT
&lt 3 LEFT_BRACKET  &kp HOME        &kp END         &kp LEFT     &kp RIGHT                 &lt 1 SPACE  &lt 2 ENTER   &mo 3           &to 0      &lt 5 BACKSPACE  &lt 4 SPACE                &kp DOWN           &kp UP_ARROW  &kp PAGE_DOWN    &kp PAGE_UP       &hm RCTRL RIGHT_BRACKET
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &kp LA(F1)     &kp LA(F2)    &trans     &trans          &trans  &trans                                        &trans  &trans            &trans        &trans        &trans        &trans                &trans
&trans  &trans         &trans        &trans     &trans          &trans  &trans                                        &trans  &kp EQUAL         &kp N7        &kp N8        &kp N9        &kp NON_US_BACKSLASH  &trans
&trans  &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans      &trans  &trans    &trans  &kp MINUS         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SQT               &trans
&trans  &kp LC(Z)      &kp LC(X)     &kp LC(C)  &kp LC(V)       &trans                  &trans      &trans                    &kp LEFT_BRACKET  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp MINUS             &trans
&trans  &trans         &trans        &trans     &kp KP_NUMLOCK          &trans  &trans  &trans      &trans  &kp BSPC  &kp N0                    &kp PERIOD    &none         &trans        &trans                &trans
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans  &trans                                      &trans                 &trans          &trans           &trans        &trans                &trans             &trans
&trans  &trans     &trans     &trans     &trans     &trans  &trans                                      &trans                 &kp PLUS        &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp PIPE           &trans
&trans  &trans     &trans     &trans     &trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans                 &kp UNDERSCORE  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp DOUBLE_QUOTES  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(D)  &trans                  &trans      &trans                                 &kp LEFT_BRACE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp RIGHT_BRACE    &trans
&trans  &trans     &trans     &trans     &trans             &trans  &trans  &trans      &trans  &trans  &kp RIGHT_PARENTHESIS                  &trans           &trans        &trans                &trans             &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &kp LA(LC(F1))  &kp LA(LC(F2))  &trans  &trans  &trans  &trans                                      &trans  &trans           &trans             &trans  &trans  &trans   &trans
&trans  &trans          &trans          &trans  &trans  &trans  &trans                                      &trans  &kp SYSREQ       &kp F7             &kp F8  &kp F9  &kp F12  &trans
&trans  &trans          &trans          &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp SCROLLLOCK   &kp F4             &kp F5  &kp F6  &kp F11  &trans
&trans  &trans          &trans          &trans  &trans  &trans                  &trans      &trans                  &kp PAUSE_BREAK  &kp F1             &kp F2  &kp F3  &kp F10  &trans
&trans  &trans          &trans          &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                   &kp K_APPLICATION  &trans  &trans  &trans   &trans
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&trans  &kp LA(LC(F1))  &kp LA(LC(F2))  &trans         &trans           &trans    &trans                                          &trans  &trans           &trans     &trans    &trans    &trans  &trans
&trans  &kp GRAVE       &kp LC(INSERT)  &kp UP_ARROW   &kp LS(INS)      &kp CAPS  &trans                                          &trans  &trans           &trans     &trans    &trans    &trans  &trans
&trans  &kp HOME        &kp LEFT        &kp DOWN       &kp RIGHT_ARROW  &kp END   &trans     &trans   &trans      &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp LCTRL  &kp LALT  &kp RGUI  &trans  &trans
&trans  &caps_word      &kp DEL         &kp PAGE_DOWN  &kp PG_UP        &kp INS                       &trans      &trans                  &trans           &trans     &kp RALT  &trans    &trans  &trans
&trans  &trans          &trans          &trans         &trans                     &kp SPACE  &kp RET  &trans      &trans  &trans  &trans                   &trans     &trans    &trans    &trans  &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans          &trans          &trans          &trans               &trans           &trans                                            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp TILDE       &kp LS(INSERT)  &mmv MOVE_UP    &kp LC(PRINTSCREEN)  &none            &trans                                            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT      &msc SCRL_RIGHT  &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &caps_word      &trans          &msc SCRL_DOWN  &kp K_SCROLL_UP      &trans                                 &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans          &mkp MCLK                             &mkp LCLK  &mkp RCLK  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
