#include <dt-bindings/zmk/stp.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600

//#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mmv {
    time-to-max-speed-ms = <200>;
    trigger-period-ms = <20>;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_modsL {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODSL";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 21 40 39 54 8 22 9 23 41 55 71 10 24 42 56 72 25 11 43 57 73 12 26 44 58 74 75 59 45 27 13 38 37 53 68 69 70>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 0 14 28 46 60 1 2 3 4 5 6 15 16 17 18 19 20 29 30 31 32 33 34 35 36 47 48 49 50 51 52 61 62 63 64 65 66 67>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1    &kp N2   &kp N3    &kp N4     &kp N5  &studio_unlock                                                             &mo 1              &kp N6  &kp N7    &kp N8        &kp N9         &kp N0         &kp MINUS
&kp TAB    &kp Q     &kp W    &kp F     &kp P      &kp V   &kp EQUAL                                                                  &kp LEFT_BRACKET   &kp J   &kp L     &kp U         &kp Y          &kp SEMICOLON  &kp BSLH
&kp ESC    &kp A     &kp R    &kp S     &kp T      &kp G   &kp CAPS        &kp LCTRL  &kp LGUI          &kp RGUI       &kp RCTRL      &kp RIGHT_BRACKET  &kp M   &kp N     &kp E         &kp I          &kp O          &kp SQT
&kp LSHFT  &kp Z     &kp X    &kp C     &kp D      &kp B                              &kp DELETE        &kp INS                                          &kp K   &kp H     &kp COMMA     &kp PERIOD     &kp FSLH       &kp RSHFT
&mo 2      &kp HOME  &kp END  &kp LEFT  &kp RIGHT          &kp SPACE       &kp ENTER  &kp LEFT_ALT      &kp RIGHT_ALT  &kp BACKSPACE  &kp SPACE                  &kp DOWN  &kp UP_ARROW  &kp PAGE_DOWN  &kp PAGE_UP    &mo 2
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Fn {
            bindings = <
&kp F11         &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans                                      &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans          &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans   &trans
&studio_unlock  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans          &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans   &trans
&trans          &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };
    };
};
